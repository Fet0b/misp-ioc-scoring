# Configure URLs and secret references in the deployment environment.
POSTGRES_DB=misp_ioc_scoring
POSTGRES_HOST=database
POSTGRES_PORT=5432
COLLECTOR_DATABASE_URL=
SCORING_DATABASE_URL=
OBSERVER_DATABASE_URL=
COLLECTOR_DB_PASSWORD_SECRET_REF=
SCORING_DB_PASSWORD_SECRET_REF=
OBSERVER_DB_PASSWORD_SECRET_REF=

# Collection endpoints and credentials are supplied as secret references.
MISP_ENDPOINTS_SECRET_REF=
MISP_TO_IDS_ONLY=true
COLLECTION_OVERLAP_MINUTES=
COLLECTION_RETRY_ATTEMPTS=
COLLECTION_RETRY_BACKOFF_SECONDS=
RECONCILE_MAX_REMOVAL_RATIO=

# Operational schedules must be set explicitly.
SCORING_DAILY_CRON=
SHARING_INTERVAL_SECONDS=
SHARING_RETRY_ATTEMPTS=
SHARING_RETRY_BACKOFF_SECONDS=
SCORE_MAX_AGE_HOURS=48

# CARIOCA parameters without published values are explicit configuration.
CARIOCA_CONFIG_PATH=/app/config/carioca-orgc-proxy-v3.yaml
CARIOCA_TOP_N=

# Excel observability export.
EXPORT_OUTPUT_DIR=/output
EXPORT_MAX_ROWS_PER_SHEET=1000000

# Peer settings are consumed only by scoring/sharing.
MISP_PEERS_SECRET_REF=
PEER_MINIMUM_SCORES_SECRET_REF=
PEER_CREDENTIALS_SECRET_REF=

# Per-endpoint cadence values are supplied via secret/config reference.
COLLECTION_CADENCE_SECRET_REF=
POSTGRES_ADMIN_PASSWORD=
