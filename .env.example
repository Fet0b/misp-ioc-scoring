# Configure URLs and secret references in the deployment environment.
POSTGRES_DB=misp_ioc_scoring
POSTGRES_HOST=database
POSTGRES_PORT=5432
COLLECTOR_DATABASE_URL=
SCORING_DATABASE_URL=
OBSERVER_DATABASE_URL=
COLLECTOR_DB_PASSWORD_SECRET_REF=
SCORING_DB_PASSWORD_SECRET_REF=
OBSERVER_DB_PASSWORD_SECRET_REF=

# Collection endpoints and credentials are supplied as secret references.
MISP_ENDPOINTS_SECRET_REF=
MISP_TO_IDS_ONLY=false
COLLECTION_OVERLAP_MINUTES=
COLLECTION_RETRY_ATTEMPTS=
COLLECTION_RETRY_BACKOFF_SECONDS=
RECONCILE_MAX_REMOVAL_RATIO=

# Operational schedules must be set explicitly.
SCORING_DAILY_CRON=
SHARING_INTERVAL_SECONDS=
SHARING_RETRY_ATTEMPTS=
SHARING_RETRY_BACKOFF_SECONDS=
SCORE_MAX_AGE_HOURS=48

# CARIOCA parameters, including top_n, live only in the versioned YAML file
# (mounted read-only from ./config). SCORING_CARIOCA_ENABLED=true requires approved: true.
CARIOCA_CONFIG_PATH=/app/config/carioca-orgc-proxy-v3.yaml

# Excel observability export.
EXPORT_OUTPUT_DIR=/output
EXPORT_MAX_ROWS_PER_SHEET=1000000

# MISP peers (SHARING_MISP_ENABLED=true; requires SCORING_CARIOCA_ENABLED=true).
# The referenced JSON holds the local outbound instance and the peers, with
# minimum_priority_score 0-100, distribution and credential_secret_ref references only.
MISP_PEERS_DIR=./secrets/misp-peers
MISP_PEERS_SECRET_REF=file:/run/misp-peers/peers.json

# Per-endpoint cadence values are supplied via secret/config reference.
COLLECTION_CADENCE_SECRET_REF=

# Every database URL uses postgresql+psycopg; role names are collector,
# scoring_sharing and observer. The migration URL uses the schema owner/admin.
MIGRATION_DATABASE_URL=
# Compose secret files must exist outside version control and be readable by the runtime UID.
POSTGRES_ADMIN_PASSWORD_FILE=
COLLECTOR_DB_PASSWORD_FILE=
SCORING_DB_PASSWORD_FILE=
OBSERVER_DB_PASSWORD_FILE=
COLLECTION_ENDPOINTS_FILE=
COLLECTION_CADENCE_FILE=
COLLECTOR_CREDENTIALS_DIR=
MISP_REQUEST_TIMEOUT_SECONDS=

# Workers and destinations
COLLECTION_ENABLED=true
SCORING_SIMPLE_ENABLED=false
SCORING_CARIOCA_ENABLED=false
SHARING_MISP_ENABLED=false
SHARING_PIHOLE_ENABLED=false
PIHOLE_SCORE_MODEL=default
PIHOLE_CARIOCA_MIN_SCORE=
PIHOLE_URL=
PIHOLE_INTERVAL_SECONDS=
PIHOLE_ALLOW_HTTP=false
PIHOLE_CREDENTIALS_DIR=./secrets/pihole
PIHOLE_PASSWORD_SECRET_REF=file:/run/pihole/password
